{
  "name": "ember-app",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@expo-google-fonts/inter": "^0.4.2",
    "@hookform/resolvers": "^7.0.8",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@tanstack/react-query": "^5.107.1",
    "expo": "~58.0.25",
    "expo-constants": "~58.0.16",
    "expo-font": "~58.0.12",
    "expo-linking": "~58.0.17",
    "expo-localization": "~58.0.5",
    "expo-router": "~58.0.31",
    "expo-secure-store": "~58.0.3",
    "expo-splash-screen": "~58.0.14",
    "expo-status-bar": "~58.0.5",
    "i18next": "^27.1.1",
    "lucide-react-native": "^1.72.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "^7.92.0",
    "react-i18next": "^18.0.1",
    "react-native": "0.88.1",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-web": "^0.21.4",
    "react-native-worklets": "0.13.0",
    "zod": "^4.6.7",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "30.0.0",
    "@types/react": "~19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~58.0.4",
    "jest": "~30.5.2",
    "jest-expo": "~58.0.14",
    "orval": "^8.47.0",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start --port 8082",
    "android": "expo start --android --port 8082",
    "ios": "expo start --ios --port 8082",
    "web": "expo start --web --port 8082",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "api": "orval --config orval.config.ts"
  },
  "private": true,
  "jest": {
    "preset": "jest-expo",
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/src/$1",
      "^lucide-react-native/icons/(.*)$": "<rootDir>/node_modules/lucide-react-native/dist/cjs/icons/$1.js"
    },
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/dist/"
    ],
    "setupFiles": [
      "<rootDir>/jest.setup.ts"
    ]
  }
}
