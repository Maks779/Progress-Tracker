# Draft. The final variable list is fixed when the backend is scaffolded.
# Copy to .env and change the values. Never commit .env.

# --- Database ---
POSTGRES_USER=progress
POSTGRES_PASSWORD=change-me
POSTGRES_DB=progress_tracker
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://progress:change-me@localhost:5432/progress_tracker

# --- Auth ---
JWT_SECRET=change-me-to-a-long-random-string
JWT_ACCESS_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30

# --- API ---
API_PORT=8000
CORS_ORIGINS=http://localhost:8081

# --- Frontend (Expo inlines EXPO_PUBLIC_* variables at build time) ---
EXPO_PUBLIC_API_URL=http://localhost:8000/api/v1
