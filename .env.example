# Draft. The final variable list is fixed when the backend is scaffolded.
# Copy to .env and change the values. Never commit .env.

# --- Database ---
POSTGRES_USER=progress
POSTGRES_PASSWORD=change-me
POSTGRES_DB=progress_tracker
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://progress:change-me@localhost:5432/progress_tracker

# --- Auth ---
JWT_SECRET=change-me-to-a-long-random-string
JWT_ACCESS_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30
PASSWORD_RESET_TTL_MINUTES=30
COOKIE_SECURE=true
WEB_APP_URL=http://localhost:8081

# --- Email (password reset) ---
# Docker Compose sends to Mailpit (http://localhost:8025) unless these are set.
# Live: a Gmail account for Ember with 2-Step Verification and an app password.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_STARTTLS=true
# SMTP_USERNAME=ember.example@gmail.com
# SMTP_PASSWORD=the-16-letter-app-password
# EMAIL_FROM=Ember <ember.example@gmail.com>

# --- API ---
API_PORT=8000
CORS_ORIGINS=http://localhost:8081

# --- Frontend (Expo inlines EXPO_PUBLIC_* variables at build time) ---
EXPO_PUBLIC_API_URL=http://localhost:8000
